{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["memory/constitution.md"],
  "permission": {
    "edit": {
      "*": "allow",
      "*.py": "deny",
      "tests/**": "allow",
      ".env": "deny",
      ".env.*": "deny",
      ".env.example": "allow",
      "data/**": "deny",
      "memory/constitution.md": "deny"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git push*": "deny",
      "git merge*": "deny",
      "git reset --hard*": "deny",
      "rm *": "deny",
      "Remove-Item *": "deny",
      "del *": "deny"
    }
  }
}
